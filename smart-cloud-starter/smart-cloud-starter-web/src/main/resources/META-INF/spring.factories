# Auto Configure
org.springframework.boot.autoconfigure.EnableAutoConfiguration=\
io.github.smart.cloud.starter.web.autoconfigure.ApiLogAspectAutoConfiguration,\
io.github.smart.cloud.starter.web.autoconfigure.ExceptionControllerAdviceAutoConfiguration

# Environment Post Processor
org.springframework.boot.env.EnvironmentPostProcessor=\
io.github.smart.cloud.starter.web.WebDefaultPropertiesEnvironmentPostProcessor